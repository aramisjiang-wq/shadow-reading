{
  "name": "shadow-reading",
  "version": "4.0.0",
  "private": true,
  "description": "Article-first English reading, listening and vocabulary practice workspace",
  "scripts": {
    "build": "node scripts/build-site.cjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-check.cjs",
    "test:articles": "node tests/article-browser.cjs",
    "test:ui": "node tests/ui-browser.cjs",
    "export:articles": "node scripts/export-reading-materials.cjs",
    "start": "python3 -m http.server 8765 --bind 127.0.0.1"
  },
  "devDependencies": {"playwright": "1.62.1"}
}
